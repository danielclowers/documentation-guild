{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "documentation-guild-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "WEB_URL": "http://localhost:5173/documentation-guild/",
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "CLERK_AUDIENCE": "documentation-guild-api",
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
  ],
  "durable_objects": { "bindings": [{ "name": "GUILD_ROOM", "class_name": "GuildRoom" }] },
  "migrations": [{ "tag": "hall-v1", "new_sqlite_classes": ["GuildRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "documentation-guild-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
}
